# ── Atlas Agents — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your keys.
# Every model name used by the chapters is read from here (see shared/config.py).

# ══ Option A: cloud providers ═════════════════════════════════════
# At least one of these is required:
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override default models
# OPENAI_MODEL=gpt-4o
# OPENAI_FAST_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-sonnet-4-6          # main tier
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5      # cheap tier (classifiers, judges, compaction)
# ANTHROPIC_STRONG_MODEL=claude-opus-4-8     # strongest tier (fix loops, /learn)
# EMBED_MODEL=text-embedding-3-small
# OLLAMA_MODEL=llama3:8b
# LITELLM_MODEL=openai/gpt-4o

# ══ Option B: fully local — Gemma 4 on Ollama ═════════════════════
# Delete Option A above, then uncomment everything below.
# Ollama serves an OpenAI-compatible API at /v1 and an Anthropic-compatible
# API at the root (Ollama >= 0.14). The keys are placeholders; Ollama ignores them.
# See "Run everything locally with Gemma 4 on Ollama" in README.md.
#
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=gemma4-longctx
# OPENAI_FAST_MODEL=gemma4-longctx
#
# ANTHROPIC_BASE_URL=http://localhost:11434
# ANTHROPIC_API_KEY=ollama
# ANTHROPIC_MODEL=gemma4-longctx
# ANTHROPIC_FAST_MODEL=gemma4-longctx        # or gemma4:e4b for a real cheap tier
# ANTHROPIC_STRONG_MODEL=gemma4-longctx
#
# OLLAMA_MODEL=gemma4-longctx
# LITELLM_MODEL=ollama_chat/gemma4-longctx
# EMBED_MODEL=embeddinggemma
# ENABLE_THINKING=false
# (leave GOOGLE_API_KEY unset: Gemini-only paths fall back to local equivalents)
